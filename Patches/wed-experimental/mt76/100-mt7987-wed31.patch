+static int mt7996_dma_wed_rx_init(struct mt7996_dev *dev)
+{
+	struct mtk_wed_device *wed = &dev->mt76.mmio.wed;
+	struct mt76_queue *q = &dev->mt76.q_rx[MT_RXQ_WED_RX_DATA];
