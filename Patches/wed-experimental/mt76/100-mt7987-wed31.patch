Subject: [PATCH] mt76: wire MT7987 WED3.1 into the stable MT7990 path

Base: openwrt/mt76 018f60316d4dd6b4e741874eda40e2dfaa29df3b
Apply after this project's mt76-known-good patches 002 through 006.
Reference: mediatek/softmac_mt76 mp4.3-6.12
           5021497903176e83144dde2ac53d34f55e1d2647

Extract WED3.1 RXDMAD_C setup, dedicated host RX ring, descriptor completion,
register masks and MT7990 TX-free routing. Keep the stable token partition,
existing PPE station-index compatibility and non-WED/NPU queue interfaces.
Include RX interrupt masking and full-reset RXDMAD_C reinitialization, not
just the attach-time fields. Merge MT7990 HIF2 TX-free into the common
mask-before-NAPI path. Fail visibly if explicitly enabled WED cannot attach,
rather than reporting success through a newly added fallback.

Requires the kernel 999-wed-10 interface, including
mtk_wed_device_rro_3_1_rx_ring_setup(), and 999-wed-23's nbuf-based TX BM
counts. Does not require 999-wed-18 or optional 999-wed-19 IRQ modes.
Preserves the legacy three-page V3 path and legacy ID flow-control handling;
MT7990 dual-HIF primary-WED AMSDU flow-control parity remains unverified.
No firmware, hardware traffic, PPE binding or reset-recovery claim is made.
Original source licenses and copyright notices are preserved.

diff --git a/dma.c b/dma.c
index f8c2fe5..ff7e6ca 100644
--- a/dma.c
+++ b/dma.c
@@ -422,6 +422,10 @@ mt76_dma_tx_cleanup(struct mt76_dev *dev, struct mt76_queue *q, bool flush)
 		last = Q_READ(q, dma_idx);
 
 	while (q->queued > 0 && q->tail != last) {
+		if (!flush && (q->flags & MT_QFLAG_CHECK_DDONE) &&
+		    !(q->desc[q->tail].ctrl & cpu_to_le32(MT_DMA_CTL_DMA_DONE)))
+			break;
+
 		mt76_dma_tx_cleanup_idx(dev, q, q->tail, &entry);
 		mt76_npu_txdesc_cleanup(q, q->tail);
 		mt76_queue_tx_complete(dev, q, &entry);
@@ -490,6 +494,42 @@ mt76_dma_get_rxdmad_c_buf(struct mt76_dev *dev, struct mt76_queue *q,
 	return buf;
 }
 
+static struct mt76_txwi_cache *
+mt76_dma_wed_rx_token(struct mt76_dev *dev, struct mt76_desc *desc, bool more)
+{
+	u32 buf1 = le32_to_cpu(desc->buf1);
+	u32 token = FIELD_GET(MT_DMA_CTL_TOKEN, buf1);
+	struct mt76_txwi_cache *t;
+	int id;
+
+	if (!more || dev->mmio.wed.version != MTK_WED_HW_V3_1)
+		return mt76_rx_token_release(dev, token);
+
+	/* A fragmented WED RX descriptor can carry the previous buffer's token. */
+	spin_lock_bh(&dev->rx_token_lock);
+	t = idr_find(&dev->rx_token, token);
+	if (t && t->dma_addr == le32_to_cpu(desc->buf0))
+		goto release;
+
+	idr_for_each_entry(&dev->rx_token, t, id) {
+		if (t->dma_addr != le32_to_cpu(desc->buf0))
+			continue;
+		token = id;
+		buf1 &= ~MT_DMA_CTL_TOKEN;
+		buf1 |= FIELD_PREP(MT_DMA_CTL_TOKEN, token);
+		WRITE_ONCE(desc->buf1, cpu_to_le32(buf1));
+		goto release;
+	}
+	spin_unlock_bh(&dev->rx_token_lock);
+	dev_err_ratelimited(dev->dev, "WED RX fragment DMA address has no token\n");
+	return NULL;
+
+release:
+	t = idr_remove(&dev->rx_token, token);
+	spin_unlock_bh(&dev->rx_token_lock);
+	return t;
+}
+
 static void *
 mt76_dma_get_buf(struct mt76_dev *dev, struct mt76_queue *q, int idx,
 		 int *len, u32 *info, bool *more, bool *drop, bool flush)
@@ -519,8 +559,9 @@ mt76_dma_get_buf(struct mt76_dev *dev, struct mt76_queue *q, int idx,
 	mt76_dma_should_drop_buf(drop, ctrl, buf1, desc_info);
 
 	if (mt76_queue_is_wed_rx(q)) {
-		u32 token = FIELD_GET(MT_DMA_CTL_TOKEN, buf1);
-		struct mt76_txwi_cache *t = mt76_rx_token_release(dev, token);
+		struct mt76_txwi_cache *t;
+
+		t = mt76_dma_wed_rx_token(dev, desc, !flush && more && *more);
 
 		if (!t)
 			return NULL;
@@ -534,7 +575,7 @@ mt76_dma_get_buf(struct mt76_dev *dev, struct mt76_queue *q, int idx,
 		t->ptr = NULL;
 
 		mt76_put_rxwi(dev, t);
-		if (drop)
+		if (drop && dev->mmio.wed.version == MTK_WED_HW_V2)
 			*drop |= !!(buf1 & MT_DMA_CTL_WO_DROP);
 	} else {
 		dma_sync_single_for_cpu(dev->dma_dev, e->dma_addr[0],
@@ -595,6 +636,10 @@ mt76_dma_dequeue(struct mt76_dev *dev, struct mt76_queue *q, bool flush,
 			q->desc[idx].ctrl |= cpu_to_le32(MT_DMA_CTL_DMA_DONE);
 		else if (!(q->desc[idx].ctrl & cpu_to_le32(MT_DMA_CTL_DMA_DONE)))
 			return NULL;
+		else if (dev->mmio.wed.version > MTK_WED_HW_V2 &&
+			 mt76_queue_is_wed_tx_free(q) &&
+			 !(q->desc[idx].ctrl & cpu_to_le32(MT_DMA_CTL_M_DONE)))
+			return NULL;
 	}
 done:
 	q->tail = (q->tail + 1) % q->ndesc;
diff --git a/dma.h b/dma.h
index 298ceff..a88d27c 100644
--- a/dma.h
+++ b/dma.h
@@ -11,7 +11,7 @@
 
 #define MT_DMA_CTL_SD_LEN1		GENMASK(13, 0)
 #define MT_DMA_CTL_LAST_SEC1		BIT(14)
-#define MT_DMA_CTL_BURST		BIT(15)
+#define MT_DMA_CTL_M_DONE		BIT(15)
 #define MT_DMA_CTL_SD_LEN0		GENMASK(29, 16)
 #define MT_DMA_CTL_LAST_SEC0		BIT(30)
 #define MT_DMA_CTL_DMA_DONE		BIT(31)
@@ -48,6 +48,26 @@
 
 #if IS_ENABLED(CONFIG_NET_MEDIATEK_SOC_WED)
 
+#define MT_WED_RING_SIZE_MASK	GENMASK(15, 0)
+#define MT_WED_RING_IDX_MASK	GENMASK(11, 0)
+
+static inline u32
+mt76_dma_wed_mask(struct mt76_queue *q, u32 offset)
+{
+	if (q->dev->mmio.wed.version != MTK_WED_HW_V3_1)
+		return U32_MAX;
+
+	switch (offset) {
+	case offsetof(struct mt76_queue_regs, ring_size):
+		return MT_WED_RING_SIZE_MASK;
+	case offsetof(struct mt76_queue_regs, cpu_idx):
+	case offsetof(struct mt76_queue_regs, dma_idx):
+		return MT_WED_RING_IDX_MASK;
+	default:
+		return U32_MAX;
+	}
+}
+
 #define Q_READ(_q, _field) ({						\
 	u32 _offset = offsetof(struct mt76_queue_regs, _field);		\
 	u32 _val;							\
@@ -57,11 +77,25 @@
 						_offset));		\
 	else								\
 		_val = readl(&(_q)->regs->_field);			\
-	_val;								\
+	_val & mt76_dma_wed_mask(_q, _offset);				\
 })
 
-#define Q_WRITE(_q, _field, _val)	do {				\
+#define Q_WRITE(_q, _field, _value)	do {				\
 	u32 _offset = offsetof(struct mt76_queue_regs, _field);		\
+	u32 _mask = mt76_dma_wed_mask(_q, _offset);			\
+	u32 _val = (_value);						\
+	/* Reset DIDX fully; preserve WED control bits on other writes. */ \
+	if (_offset == offsetof(struct mt76_queue_regs, dma_idx))		\
+		_mask = U32_MAX;						\
+	if (_mask != U32_MAX) {						\
+		u32 _old;						\
+		if ((_q)->flags & MT_QFLAG_WED)				\
+			_old = mtk_wed_device_reg_read((_q)->wed,		\
+					(_q)->wed_regs + _offset);	\
+		else							\
+			_old = readl(&(_q)->regs->_field);		\
+		_val = (_old & ~_mask) | (_val & _mask);			\
+	}								\
 	if ((_q)->flags & MT_QFLAG_WED)					\
 		mtk_wed_device_reg_write((_q)->wed,			\
 					 ((_q)->wed_regs + _offset),	\
