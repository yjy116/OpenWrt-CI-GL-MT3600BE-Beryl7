 	q->flags = MT_WED_Q_RX(0);
@@ -778,7 +778,7 @@ int mt7996_dma_init(struct mt7996_dev *dev)
 
 	/* rx data queue for band0 and mt7996 band1 */
 	if (mtk_wed_device_active(wed) && mtk_wed_get_rx_capa(wed) &&
-	    wed->version != MTK_WED_HW_V3_1) {
