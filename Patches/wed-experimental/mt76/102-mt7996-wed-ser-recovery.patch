 		}
@@ -1003,12 +1003,20 @@ int mt7996_dma_init(struct mt7996_dev *dev)
 	return 0;
 }
 
-void mt7996_dma_reset(struct mt7996_dev *dev, bool force)
+int mt7996_dma_reset(struct mt7996_dev *dev, bool force)
 {
 	struct mt76_phy *phy2 = dev->mt76.phys[MT_BAND1];
 	struct mt76_phy *phy3 = dev->mt76.phys[MT_BAND2];
 	u32 hif1_ofs = MT_WFDMA0_PCIE1(0) - MT_WFDMA0(0);
-	int i;
+	int i, ret = 0, err;
+
+	/* Quiesce external DMA before cleaning queues or resetting WFSYS. */
+	if (force) {
+		if (mtk_wed_device_active(&dev->mt76.mmio.wed_hif2))
+			mtk_wed_device_stop(&dev->mt76.mmio.wed_hif2);
+		if (mtk_wed_device_active(&dev->mt76.mmio.wed))
+			mtk_wed_device_stop(&dev->mt76.mmio.wed);
+	}
 
 	mt76_clear(dev, MT_WFDMA0_GLO_CFG,
 		   MT_WFDMA0_GLO_CFG_TX_DMA_EN |
@@ -1021,6 +1029,12 @@ void mt7996_dma_reset(struct mt7996_dev *dev, bool force)
 
 	usleep_range(1000, 2000);
 
+	if (force) {
+		/* WED 和 WLAN DMA 均已停下，此时才能归还未完成的 TX token。 */
+		mt7996_tx_token_put(dev);
+		idr_init(&dev->mt76.token);
+	}
+
 	for (i = 0; i < __MT_TXQ_MAX; i++) {
 		mt76_queue_tx_cleanup(dev, dev->mphy.q_tx[i], true);
 		if (phy2)
@@ -1046,14 +1060,19 @@ void mt7996_dma_reset(struct mt7996_dev *dev, bool force)
 		mt7996_wfsys_reset(dev);
 
 	if (dev->hif2 && mtk_wed_device_active(&dev->mt76.mmio.wed_hif2))
-		mtk_wed_device_dma_reset(&dev->mt76.mmio.wed_hif2);
+		ret = mt76_wed_device_dma_reset(&dev->mt76.mmio.wed_hif2);
 
-	if (mtk_wed_device_active(&dev->mt76.mmio.wed))
-		mtk_wed_device_dma_reset(&dev->mt76.mmio.wed);
+	if (mtk_wed_device_active(&dev->mt76.mmio.wed)) {
+		err = mt76_wed_device_dma_reset(&dev->mt76.mmio.wed);
+		if (!ret)
+			ret = err;
+	}
 
 	mt76_npu_disable_irqs(&dev->mt76);
 	mt7996_dma_disable(dev, force);
 	mt76_wed_dma_reset(&dev->mt76);
+	if (ret)
+		return ret;
 
 	/* reset hw queues */
 	for (i = 0; i < __MT_TXQ_MAX; i++) {
@@ -1094,6 +1113,8 @@ void mt7996_dma_reset(struct mt7996_dev *dev, bool force)
 	}
 
 	mt7996_dma_enable(dev, !force);
+
+	return 0;
 }
 
 void mt7996_dma_cleanup(struct mt7996_dev *dev)
diff --git a/mt7996/init.c b/mt7996/init.c
index f9f0900..36504b8 100644
--- a/mt7996/init.c
+++ b/mt7996/init.c
@@ -1799,6 +1799,8 @@ error:
 
 void mt7996_unregister_device(struct mt7996_dev *dev)
 {
+	int i;
+
 	cancel_work_sync(&dev->dump_work);
 	cancel_work_sync(&dev->wed_rro.work);
 	mt7996_unregister_phy(mt7996_phy3(dev));
@@ -1806,6 +1808,14 @@ void mt7996_unregister_device(struct mt7996_dev *dev)
 	mt7996_unregister_thermal(&dev->phy);
 	mt7996_coredump_unregister(dev);
 	mt76_unregister_device(&dev->mt76);
+	if (mtk_wed_device_active(&dev->mt76.mmio.wed_hif2))
+		mtk_wed_device_stop(&dev->mt76.mmio.wed_hif2);
+	if (mtk_wed_device_active(&dev->mt76.mmio.wed))
+		mtk_wed_device_stop(&dev->mt76.mmio.wed);
+	for (i = 0; i < ARRAY_SIZE(dev->mt76.napi); i++) {
+		if (dev->mt76.napi[i].dev)
+			napi_disable(&dev->mt76.napi[i]);
+	}
 	mt7996_wed_rro_free(dev);
 	mt7996_mcu_exit(dev);
 	mt7996_tx_token_put(dev);
diff --git a/mt7996/mac.c b/mt7996/mac.c
index 354b101..2fbaaa3 100644
--- a/mt7996/mac.c
+++ b/mt7996/mac.c
@@ -4,7 +4,9 @@
  */
 
 #include <linux/etherdevice.h>
+#include <linux/rtnetlink.h>
 #include <linux/timekeeping.h>
+#include <net/netfilter/nf_flow_table.h>
 #include "coredump.h"
 #include "mt7996.h"
 #include "../dma.h"
@@ -2234,14 +2236,16 @@ void mt7996_tx_token_put(struct mt7996_dev *dev)
 		mt7996_txwi_free(dev, txwi, NULL, NULL, NULL);
 		dev->mt76.token_count--;
 	}
-	spin_unlock_bh(&dev->mt76.token_lock);
 	idr_destroy(&dev->mt76.token);
+	dev->mt76.wed_token_count = 0;
+	spin_unlock_bh(&dev->mt76.token_lock);
 
 	for (id = 0; id < __MT_MAX_BAND; id++) {
 		struct mt76_phy *phy = dev->mt76.phys[id];
 		if (phy)
 			atomic_set(&phy->mgmt_tx_pending, 0);
 	}
+	wake_up(&dev->mt76.tx_wait);
 }
 
 static int
@@ -2283,11 +2287,7 @@ mt7996_mac_restart(struct mt7996_dev *dev)
 	}
 	napi_disable(&dev->mt76.tx_napi);
 
-	/* token reinit */
-	mt7996_tx_token_put(dev);
-	idr_init(&dev->mt76.token);
-
-	mt7996_dma_reset(dev, true);
+	ret = mt7996_dma_reset(dev, true);
 
 	mt76_for_each_q_rx(mdev, i) {
 		if (mtk_wed_device_active(&dev->mt76.mmio.wed) &&
@@ -2296,11 +2296,16 @@ mt7996_mac_restart(struct mt7996_dev *dev)
 
 		if (mdev->q_rx[i].ndesc) {
 			napi_enable(&dev->mt76.napi[i]);
+			if (ret)
+				continue;
 			local_bh_disable();
 			napi_schedule(&dev->mt76.napi[i]);
 			local_bh_enable();
 		}
 	}
+	if (ret)
+		goto out;
+
 	clear_bit(MT76_MCU_RESET, &dev->mphy.state);
 	clear_bit(MT76_STATE_MCU_RUNNING, &dev->mphy.state);
 
@@ -2334,7 +2339,7 @@ mt7996_mac_restart(struct mt7996_dev *dev)
 				mt76_queue_rx_reset(dev, i);
 		}
 
-		if (dev->mt76.mmio.wed.version == MTK_WED_HW_V3_1)
+		if (mt76_wed_is_v3_1(&dev->mt76.mmio.wed))
 			wed_irq_mask |= MT_INT_RX(MT_RXQ_WED_RX_DATA);
 		mt76_wr(dev, MT_INT_MASK_CSR, wed_irq_mask);
 		mtk_wed_device_start_hw_rro(&dev->mt76.mmio.wed, wed_irq_mask,
@@ -2373,13 +2378,16 @@ mt7996_mac_restart(struct mt7996_dev *dev)
 
 out:
 	/* reset done */
-	mt7996_for_each_phy(dev, phy)
-		clear_bit(MT76_RESET, &phy->mt76->state);
+	if (!ret)
+		mt7996_for_each_phy(dev, phy)
+			clear_bit(MT76_RESET, &phy->mt76->state);
 
 	napi_enable(&dev->mt76.tx_napi);
-	local_bh_disable();
-	napi_schedule(&dev->mt76.tx_napi);
-	local_bh_enable();
+	if (!ret) {
+		local_bh_disable();
+		napi_schedule(&dev->mt76.tx_napi);
+		local_bh_enable();
+	}
 
 	mt76_worker_enable(&dev->mt76.tx_worker);
 	return ret;
@@ -2417,7 +2425,72 @@ mt7996_mac_reset_vif_iter(void *data, u8 *mac, struct ieee80211_vif *vif)
 	rcu_read_unlock();
 }
 
+#if IS_ENABLED(CONFIG_NF_FLOW_TABLE)
+static bool
+mt7996_wed_flow_netdev(struct wiphy *wiphy, struct net_device *netdev)
+{
+	struct net_device *lower;
+
+	for_each_netdev(wiphy_net(wiphy), lower) {
+		if (!lower->ieee80211_ptr ||
+		    lower->ieee80211_ptr->wiphy != wiphy)
+			continue;
+
+		if (lower == netdev ||
+		    netdev_has_upper_dev_all_rcu(lower, netdev))
+			return true;
+	}
+
+	return false;
+}
+#endif
+
 static void
+mt7996_wed_flow_cleanup(struct mt7996_dev *dev)
+{
+#if IS_ENABLED(CONFIG_NF_FLOW_TABLE)
+	struct wiphy *wiphy = mt76_hw(dev)->wiphy;
+	void (*cleanup)(struct net_device *netdev);
+	struct net_device *netdev;
+	struct net *net;
+	int pass;
+
+	/* Optional: WED must also work without a loaded NF flowtable module. */
+	cleanup = symbol_get(nf_flow_table_cleanup);
+	if (!cleanup)
+		return;
+
+	rtnl_lock();
+	/*
+	 * FE recovery holds hw_lock while waiting for WLAN. Its own PPE reset
+	 * must not wait for an NF flow destroy taking that same lock.
+	 */
+	if (test_bit(MT76_STATE_WED_RESET, &dev->mphy.state))
+		goto out;
+
+	net = wiphy_net(wiphy);
+	/*
+	 * GC skips pending offload work. Drain it first, then run GC again to
+	 * destroy templates whose add completed during the first cleanup.
+	 */
+	for (pass = 0; pass < 2; pass++) {
+		for_each_netdev(net, netdev) {
+			bool match;
+
+			rcu_read_lock();
+			match = mt7996_wed_flow_netdev(wiphy, netdev);
+			rcu_read_unlock();
+			if (match)
+				cleanup(netdev);
+		}
+	}
+out:
+	rtnl_unlock();
+	symbol_put(nf_flow_table_cleanup);
+#endif
+}
+
+static bool
 mt7996_mac_full_reset(struct mt7996_dev *dev)
 {
 	struct ieee80211_hw *hw = mt76_hw(dev);
@@ -2430,6 +2503,18 @@ mt7996_mac_full_reset(struct mt7996_dev *dev)
 	wake_up(&dev->mt76.mcu.wait);
 	ieee80211_stop_queues(hw);
 
+	if (mtk_wed_device_active(&dev->mt76.mmio.wed) &&
+	    mt76_wed_is_v3_1(&dev->mt76.mmio.wed) &&
+	    !test_bit(MT76_STATE_WED_RESET, &dev->mphy.state)) {
+		/* Block WINFO extraction before retiring cached templates. */
+		smp_store_release(&dev->recovery.flow_blocked, true);
+		/*
+		 * This work holds no mt76, wiphy or RTNL lock here. Invalidate
+		 * cached WINFO before reusing station WCIDs or interface BSS IDs.
+		 */
+		mt7996_wed_flow_cleanup(dev);
+	}
+
 	cancel_work_sync(&dev->wed_rro.work);
 	mt7996_for_each_phy(dev, phy)
 		cancel_delayed_work_sync(&phy->mt76->mac_work);
@@ -2442,8 +2527,12 @@ mt7996_mac_full_reset(struct mt7996_dev *dev)
 			break;
 	}
 
-	if (i == 10)
-		dev_err(dev->mt76.dev, "chip full reset failed\n");
+	if (i == 10) {
+		dev_err(dev->mt76.dev, "chip full reset failed, leaving queues stopped\n");
+		dev->recovery.hw_full_reset = false;
+		mutex_unlock(&dev->mt76.mutex);
+		return false;
+	}
 
 	mt7996_for_each_phy(dev, phy)
 		phy->omac_mask = 0;
@@ -2472,11 +2561,19 @@ mt7996_mac_full_reset(struct mt7996_dev *dev)
 
 	i = mt76_wcid_alloc(dev->mt76.wcid_mask, MT7996_WTBL_STA);
 	dev->mt76.global_wcid.idx = i;
+	/*
+	 * Old station links and VIF mappings are gone. Forward paths must now
+	 * wait for a newly connected station link, rather than an asynchronous
+	 * reconfig_complete callback that can belong to an earlier reset or be
+	 * omitted entirely when all interfaces are down.
+	 */
+	smp_store_release(&dev->recovery.flow_blocked, false);
 	dev->recovery.hw_full_reset = false;
 
 	mutex_unlock(&dev->mt76.mutex);
 
 	ieee80211_restart_hw(mt76_hw(dev));
+	return true;
 }
 
 void mt7996_mac_reset_work(struct work_struct *work)
@@ -2484,7 +2581,7 @@ void mt7996_mac_reset_work(struct work_struct *work)
 	struct ieee80211_hw *hw;
 	struct mt7996_dev *dev;
 	struct mt7996_phy *phy;
-	int i;
+	int i, ret = 0;
 
 	dev = container_of(work, struct mt7996_dev, reset_work);
 	hw = mt76_hw(dev);
@@ -2500,7 +2597,10 @@ void mt7996_mac_reset_work(struct work_struct *work)
 		else
 			dev->recovery.wm_reset_count++;
 
-		mt7996_mac_full_reset(dev);
+		if (!mt7996_mac_full_reset(dev)) {
+			dev->recovery.restart = false;
+			return;
+		}
 
 		/* enable mcu irq */
 		mt7996_irq_enable(dev, MT_INT_MCU_CMD);
@@ -2563,7 +2663,9 @@ void mt7996_mac_reset_work(struct work_struct *work)
 	mt76_wr(dev, MT_MCU_INT_EVENT, MT_MCU_INT_EVENT_DMA_STOPPED);
 
 	if (mt7996_wait_reset_state(dev, MT_MCU_CMD_RESET_DONE)) {
-		mt7996_dma_reset(dev, false);
+		ret = mt7996_dma_reset(dev, false);
+		if (ret)
+			goto resume_napi;
 
 		mt7996_tx_token_put(dev);
 		idr_init(&dev->mt76.token);
@@ -2585,7 +2687,7 @@ void mt7996_mac_reset_work(struct work_struct *work)
 		u32 wed_irq_mask = MT_INT_TX_DONE_BAND2 |
 				   dev->mt76.mmio.irqmask;
 
-		if (dev->mt76.mmio.wed.version == MTK_WED_HW_V3_1)
+		if (mt76_wed_is_v3_1(&dev->mt76.mmio.wed))
 			wed_irq_mask |= MT_INT_RX(MT_RXQ_WED_RX_DATA);
 		mt76_wr(dev, MT_INT_MASK_CSR, wed_irq_mask);
 		mtk_wed_device_start_hw_rro(&dev->mt76.mmio.wed, wed_irq_mask,
@@ -2606,6 +2708,7 @@ void mt7996_mac_reset_work(struct work_struct *work)
 	mt7996_for_each_phy(dev, phy)
 		clear_bit(MT76_RESET, &phy->mt76->state);
 
+resume_napi:
 	mt76_for_each_q_rx(&dev->mt76, i) {
 		if (mtk_wed_device_active(&dev->mt76.mmio.wed) &&
 		    mt76_queue_is_wed_rro(&dev->mt76.q_rx[i]))
@@ -2619,16 +2722,28 @@ void mt7996_mac_reset_work(struct work_struct *work)
 			continue;
 
 		napi_enable(&dev->mt76.napi[i]);
+		if (ret)
+			continue;
 		local_bh_disable();
 		napi_schedule(&dev->mt76.napi[i]);
 		local_bh_enable();
 	}
 
-	tasklet_schedule(&dev->mt76.irq_tasklet);
+	if (!ret)
+		tasklet_schedule(&dev->mt76.irq_tasklet);
 
 	mt76_worker_enable(&dev->mt76.tx_worker);
 
 	napi_enable(&dev->mt76.tx_napi);
+	if (ret) {
+		mutex_unlock(&dev->mt76.mutex);
+		dev_err(dev->mt76.dev,
+			"WED DMA reset failed: %d, retrying full recovery\n", ret);
+		dev->recovery.restart = true;
+		queue_work(dev->mt76.wq, &dev->reset_work);
+		return;
+	}
+
 	local_bh_disable();
 	napi_schedule(&dev->mt76.tx_napi);
 	local_bh_enable();
