Subject: [PATCH] mt7996: quiesce WED and retire local full-reset flow templates

Adapted from Shi Jiayang's OpenWrt PR #26802, commit
597f208546756a014ab8fc7d9dc02f206f274ad6, mt76 patches 112-114.
基于 mt76 018f603 的旧关联接口移植；保留原文件许可证。
复位不成功时不开放队列，不让旧流模板重新绑定已复用的无线编号。

diff --git a/dma.c b/dma.c
index ff7e6ca..6137f1f 100644
--- a/dma.c
+++ b/dma.c
@@ -1234,7 +1234,8 @@ void mt76_dma_cleanup(struct mt76_dev *dev)
 	mt76_for_each_q_rx(dev, i) {
 		struct mt76_queue *q = &dev->q_rx[i];
 
-		netif_napi_del(&dev->napi[i]);
+		if (dev->napi[i].dev)
+			netif_napi_del(&dev->napi[i]);
 		mt76_dma_rx_cleanup(dev, q);
 
 		page_pool_destroy(q->page_pool);
diff --git a/mt76.h b/mt76.h
index 42c7e44..7ece5bc 100644
--- a/mt76.h
+++ b/mt76.h
@@ -1257,6 +1257,24 @@ void mt76_wed_dma_reset(struct mt76_dev *dev);
 int mt76_wed_net_setup_tc(struct ieee80211_hw *hw, struct ieee80211_vif *vif,
 			  struct net_device *netdev, enum tc_setup_type type,
 			  void *type_data);
+static inline bool mt76_wed_is_v3_1(struct mtk_wed_device *wed)
+{
+#ifdef CONFIG_NET_MEDIATEK_SOC_WED
+	return wed->version == MTK_WED_HW_V3_1;
+#else
+	return false;
+#endif
+}
+
+static inline int mt76_wed_device_dma_reset(struct mtk_wed_device *wed)
+{
+#ifdef CONFIG_NET_MEDIATEK_SOC_WED
+	return mtk_wed_device_dma_reset(wed);
+#else
+	return 0;
+#endif
+}
+
 #ifdef CONFIG_NET_MEDIATEK_SOC_WED
 u32 mt76_wed_init_rx_buf(struct mtk_wed_device *wed, int size);
 int mt76_wed_offload_enable(struct mtk_wed_device *wed);
